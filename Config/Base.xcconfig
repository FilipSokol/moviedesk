// Wspólna konfiguracja. Wszystko, co osobiste (Team ID, własny prefiks bundle ID),
// wpisz w Config/Local.xcconfig — ten plik nie trafia do repo.

DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = local.moviedesk

#include? "Local.xcconfig"

// Na macOS identyfikator App Group musi zaczynać się od Team ID.
APP_GROUP_ID = $(DEVELOPMENT_TEAM).$(BUNDLE_ID_PREFIX)
